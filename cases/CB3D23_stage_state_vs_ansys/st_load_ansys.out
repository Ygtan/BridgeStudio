    32  F,2,FY,-10000   
    33  F,3,FY,-10000   
    34  FINISH  
    35  /SOLU   
    36  ANTYPE,STATIC   
    37  NLGEOM,ON   
    38  NSUBST,20,100,10
    39  NEQIT,50
    40  OUTRES,ALL,ALL  
    41  TIME,1  
    42  SOLVE   
