     1  /BATCH  
     2  /TITLE,CB3D23 construction-stage intermediate state stability - FEM vs ANSYS two-step - st_arc - LINK180 NLGEOM 
     3  /PREP7  
     4  ET,1,LINK180
     5  R,1,0.001   
     6  MP,EX,1,210000000000
     7  MP,PRXY,1,0.3   
     8  ! ---- Nodes: same source as FEM .dat ----  
     9  N,1,-2,0,0  
    10  N,2,-0.69999999999999996,0.34999999999999998,0  
    11  N,3,0.69999999999999996,0.34999999999999998,0   
    12  N,4,2,0,0   
    13  ! ---- Elements: stage-2 active elements only (ANSYS elem no. = creation order) ----
    14  TYPE,1  
    15  MAT,1   
    16  REAL,1  
    17  E,1,2   
    18  E,2,3   
    19  E,3,4   
    20  ! ---- Boundary conditions (FEM dof 1/2/3 = UX/UY/UZ) ----  
    21  D,1,UX,0.0  
    22  D,1,UY,0.0  
    23  D,1,UZ,0.0  
    24  D,4,UX,0.0  
    25  D,4,UY,0.0  
    26  D,4,UZ,0.0  
    27  D,2,UZ,0.0  
    28  D,3,UZ,0.0  
    29  D,2,UX,0.0  
    30  D,3,UX,0.0  
    31  ! ---- Stage 2 accumulated constant loads (F0) ---- 
    32  F,2,FY,-10000   
    33  F,3,FY,-10000   
    34  FINISH  
    35  /SOLU   
    36  ANTYPE,STATIC   
    37  NLGEOM,ON   
    38  NSUBST,20,100,10
    39  NEQIT,50
    40  OUTRES,ALL,ALL  
    41  TIME,1  
    42  SOLVE   
    43  ! ---- load step 2: incremental load (ARCLEN step 2 from stage-2 equilibrium) ----  
    44  F,2,FY,-64000   
    45  F,3,FY,-64000   
    46  ARCLEN,ON,0.005,1.0E-8  
    47  NSUBST,400,1000,20  
    48  NEQIT,60
    49  TIME,3.7
    50  OUTRES,ALL,ALL  
    51  SOLVE   
    52  FINISH  
    53  ! ---- Machine-readable results (first column = FEM id) ----
    54  /POST1  
    55  *GET,NSET,ACTIVE,0,SET,NSET 
    56  *DIM,CURV,ARRAY,NSET,4  
    57  *DO,I,1,NSET
    58   SET,,,,,,,I
    59   *GET,VY,NODE,2,U,Y 
    60   *GET,TNOW,ACTIVE,0,SET,TIME
    61   CURV(I,1)=I
    62   CURV(I,2)=TNOW 
    63   CURV(I,3)=VY   
    64   CURV(I,4)=0
    65  *ENDDO  
    66  *CFOPEN,st_arc_curve,csv
    67  *VWRITE,CURV(1,1),CURV(1,2),CURV(1,3),CURV(1,4) 
    68   (1X,F8.0,3(1X,E20.12)) 
    69  *CFCLOS 
    70  FINISH  
    71  /EXIT,NOSAVE

